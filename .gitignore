# Dependencies. pi supplies `@earendil-works/*` and bunfig.toml skips installing
# them, so a lockfile would mostly record a peer tree that is never installed.
node_modules/
bun.lock
bun.lockb
package-lock.json
pnpm-lock.yaml
yarn.lock

# Build output
dist/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Env files (may contain secrets)
.env
.env.*
!.env.example

# Editor/IDE
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store

# Package manager
.pnpm-store/

# Agent working notes (local design records)
.agent/
